# ---- 0G agent service ----
# Provisions agent wallets and lets a 0G Compute model drive a limit order to a fill.
# Deploy as a SEPARATE Coolify service (not the static Safe App, not the publisher).
# Build context = repo root: it runs the runner from skills/hourglass-agent/scripts.
#
# Needs a PERSISTENT VOLUME on /app/.agent-runs. That directory holds the agent private
# keys, and a mandate is signed to an agent address — losing the key means an order
# nobody can fill and gas nobody can recover. Without the volume, every redeploy
# destroys any order that has not filled yet.
FROM oven/bun:1

# The model drives a shell; give it the tools the skill tells it to use.
RUN apt-get update \
  && apt-get install -y --no-install-recommends git curl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

# foundry, for `cast wallet new` — the skill's documented way to create the agent wallet.
RUN curl -L https://foundry.paradigm.xyz | bash \
  && /root/.foundry/bin/foundryup
ENV PATH="/root/.foundry/bin:${PATH}"

WORKDIR /app

COPY package.json .npmrc ./
# bun.lock is gitignored, so don't require a frozen lockfile.
RUN bun install

COPY . .

# Pre-install the runner's own dependencies so the agent does not spend steps on it.
RUN cd skills/hourglass-agent/scripts && bun install

ENV OG_AGENT_PORT=8789
ENV AGENT_RUNS_DIR=/app/.agent-runs
VOLUME ["/app/.agent-runs"]
EXPOSE 8789
CMD ["bun", "server/og-agent-service.ts"]
